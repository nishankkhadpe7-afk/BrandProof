# Leave LLM_PROVIDER empty to run deterministic + heuristic checks only.
LLM_PROVIDER=          # openai | gemini | anthropic
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=             # optional override
BRANDPROOF_AUTOSEED=1
CORS_ORIGINS=*

# Round 3
# SEMANTIC_REMOTE=1            # use Gemini embeddings alongside the local embedder (needs LLM_PROVIDER=gemini)
# TESSERACT_CMD=               # path to tesseract.exe if not on PATH
# BRANDPROOF_DEMO=1            # show demo accounts on the sign-in page; set 0 in production
